# Copy this file to .env for local development. Never commit .env.

# Application
SERVER_PORT=8080
LOG_LEVEL=info
# IANA timezone name for Winlink import/export time parsing (e.g. America/New_York, America/Chicago, America/Denver, America/Los_Angeles)
TIMEZONE=America/New_York

# Mesh integration
# Set MQTT_ENABLED=false to run in manual-entry-only mode (no mesh integration)
MQTT_ENABLED=false
# MESH_TECHNOLOGY selects which mesh radio to use: "meshtastic" (default) or "meshcore"
MESH_TECHNOLOGY=meshtastic

# MQTT broker (shared for both Meshtastic and MeshCore)
MQTT_HOST=localhost
MQTT_PORT=1883

# Meshtastic-specific
# (only used when MESH_TECHNOLOGY=meshtastic)
MQTT_REGION=US
MQTT_CHANNEL_NUM=2
MQTT_CHANNEL_NAME=LongFast
# Index (0–7) of the bridged channel in the gateway's channel list.
# Used to set MeshPacket.channel on downlink messages so the firmware transmits on the correct channel.
# Check with 'meshtastic --info' or the Meshtastic app — primary channel is 0, secondary channels are 1+.
MQTT_CHANNEL_INDEX=0
MQTT_GATEWAY_NODE_ID=a3b4c5d6
# Name displayed for the logger node on the Meshtastic mesh.
# NodeShortName is shown on device screens (max 4 chars).
MQTT_NODE_LONG_NAME=Auto Logger
MQTT_NODE_SHORT_NAME=Log

# MeshCore-specific
# (only used when MESH_TECHNOLOGY=meshcore)
# TCP address of the MeshCore node bridged by meshcore-mqtt (host:port)
MESHCORE_NODE_ADDRESS=192.168.1.50:5525
MESHCORE_CHANNEL_NAME=PUBLIC

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ares_bib_logger
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable
